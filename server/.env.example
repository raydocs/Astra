# Astra Relay Server Configuration
PORT=3001
HOST=0.0.0.0
PUBLIC_BASE_URL=https://relay.astra.app

# Session
SESSION_SECRET=change-this-to-a-random-string

# User DB (SQLite path for development)
USER_DB_PATH=./data/users.db

# Default user for development
LOGIN_EMAIL=dev@astra.app
LOGIN_PASSWORD=dev-password

# Provider API keys (server-side, never exposed to clients)
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# Free tier
PLAN=pro
SUBSCRIPTION_STATUS=active
PROVIDER_ENTITLEMENTS=openai,gemini

# Billing (optional)
BILLING_CHECKOUT_BASE_URL=https://billing.astra.app/checkout
BILLING_PORTAL_BASE_URL=https://billing.astra.app/portal
