{
  "name": "astra",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered bilingual web translation for iOS Safari",
  "scripts": {
    "dev": "wxt",
    "dev:safari": "wxt -b safari",
    "build": "wxt build",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:safari": "wxt zip -b safari",
    "postinstall": "wxt prepare",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "ai": "^6.0.137",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.1",
    "wxt": "0.20.20"
  }
}
