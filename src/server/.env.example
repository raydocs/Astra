# Astra Relay Server Configuration
ASTRA_RELAY_PORT=3001
ASTRA_RELAY_HOST=0.0.0.0
ASTRA_PUBLIC_BASE_URL=https://relay.astra.app/v1
# Data paths: explicit file paths override directory fallbacks.
ASTRA_RELAY_DATA_DIR=./data/server
# ASTRA_DATA_DIR=./data/server
ASTRA_USER_DB_PATH=./data/server/users.json
ASTRA_VIDEO_NOTE_STORE_PATH=./data/server/video-notes.json
ASTRA_LONG_RUNNING_TASK_STORE_PATH=./data/server/long-tasks.json
ASTRA_SUPPORT_REPORT_INBOX_PATH=./data/server/support-reports.json
ASTRA_SUPPORT_KNOWN_ISSUE_STORE_PATH=./data/server/support-known-issues.json
ASTRA_FEATURE_FLAG_RUNTIME_PATH=./data/server/feature-flags.json
ASTRA_CORS_ALLOWED_ORIGINS=https://astra.app,https://www.astra.app,http://127.0.0.1:4173

# Session
ASTRA_SESSION_SECRET=change-this-to-a-random-string
ASTRA_SESSION_TTL_MS=2592000000
ASTRA_SESSION_PUBLIC_BASE_URL=https://platform.astra.app/v1
ASTRA_PLATFORM_MIRROR_SECRET=
# Development/test only: echoes passwordless email sign-in codes in API responses. Keep false in production.
ASTRA_EMAIL_SIGN_IN_CODE_DEVELOPMENT_ECHO=false
# Production passwordless email delivery for mobile sign-in codes.
# Resend uses POST /emails with a Bearer API key. Verify the sender domain before launch.
# ASTRA_EMAIL_DELIVERY_PROVIDER=resend
# RESEND_API_KEY=re_...
# ASTRA_EMAIL_FROM=Astra <login@astra.app>
# Optional override for tests/proxies; production sends only to https://api.resend.com.
# ASTRA_RESEND_API_BASE_URL=https://api.resend.com

# Production OAuth ID-token verification for Apple/Google sign-in.
# Values must match the `aud` claim in provider ID tokens: Google OAuth client IDs,
# and Apple bundle IDs or Services IDs used by the native/web sign-in flow.
# ASTRA_OAUTH_GOOGLE_CLIENT_IDS=1234567890-example.apps.googleusercontent.com
# ASTRA_OAUTH_APPLE_CLIENT_IDS=so.astra.review,app.astra.web
# Development/test only: accepts pre-verified Apple/Google identity payloads.
# Keep false in production; production should use provider ID tokens above.
ASTRA_OAUTH_IDENTITY_DEVELOPMENT_REDEEM=false

# Default user for development
ASTRA_RELAY_EMAIL=dev@astra.app
ASTRA_RELAY_PASSWORD=dev-password
ASTRA_RELAY_PLAN=free
ASTRA_RELAY_SUBSCRIPTION_STATUS=active
ASTRA_PROVIDER_ENTITLEMENTS=google_translate,openai,gemini

# Plan limits — Free MUST stay strictly below Pro on every axis (paid-beta AC8
# cost guardrail; enforced by findFreeTierLimitViolations + config.test.ts).
# Free is a taste, not a workhorse: a few articles + one video's selections/day.
ASTRA_FREE_DAILY_REQUESTS=80
ASTRA_FREE_DAILY_CHARACTERS=40000
ASTRA_FREE_RPM=20
ASTRA_TRIAL_DAILY_REQUESTS=500
ASTRA_TRIAL_DAILY_CHARACTERS=100000
ASTRA_TRIAL_RPM=60
ASTRA_PRO_DAILY_REQUESTS=2000
ASTRA_PRO_DAILY_CHARACTERS=500000
ASTRA_PRO_RPM=120

# OpenRouter — route all managed translations through a single OpenRouter key.
# When set, this takes priority over individual provider keys.
OPENROUTER_API_KEY=sk-or-v1-...
# ASTRA_OPENROUTER_MODEL_MAP={"openai/gpt-5.4-nano":"openai/gpt-5.4-nano"}

# Direct provider API keys (fallback when OpenRouter is not configured)
# Google Translate uses Cloud Translation Basic v2. It does not route through OpenRouter.
GOOGLE_TRANSLATE_API_KEY=AIza...
OPENAI_API_KEY=sk-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Billing (optional)
ASTRA_BILLING_CHECKOUT_URL=https://billing.astra.app/checkout
ASTRA_BILLING_PORTAL_URL=https://billing.astra.app/portal

# Cloudflare D1 shadow bridge / consistency tooling
# These are used by both live shadow write/parity and the read-only audit/backfill dry-run CLI.
ASTRA_CF_SHADOW_WRITE_ENABLED=false
ASTRA_CF_READ_PARITY_ENABLED=false
ASTRA_CF_ACCOUNT_ID=
ASTRA_CF_D1_DATABASE_ID=
ASTRA_CF_API_TOKEN=
# Optional override for non-default API endpoints.
# ASTRA_CF_API_BASE_URL=https://api.cloudflare.com/client/v4
